DEF BALLOON Robot {

  translation 0 2 0.9

  rotation 1 0 0 1.5714

  children [

    Transform {

      scale 1.5 1.5 1.5

      children [

        Shape {

          appearance PBRAppearance {

            baseColor 1 0.137255 0.0745098

            roughness 0.1

            metalness 0

          }

