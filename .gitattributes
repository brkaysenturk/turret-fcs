# Set default behavior, in case users don't have core.autocrlf set.
* text=auto

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.stl binary
*.zip binary
*.npz binary
*.pt binary

# 3D assets line endings
*.obj text eol=lf
*.mtl text eol=lf

# GitHub Linguist language statistics
# Treat vendor HAL / CMSIS drivers as third-party vendored code
turret_fcs/stm32/turret_fcs/Drivers/** linguist-vendored

# STM32CubeIDE generated startup/linker files: keep in repo, exclude from language stats
turret_fcs/stm32/turret_fcs/Core/Startup/*.s linguist-generated
turret_fcs/stm32/turret_fcs/*.ld linguist-generated
